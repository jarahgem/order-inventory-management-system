              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"postman-cancellation-{{$timestamp}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productDId}}\",\n      \"quantity\": 4\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
