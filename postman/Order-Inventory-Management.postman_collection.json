      "type": "string"
    },
    {
      "key": "failurePaymentKey",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Health and observability",
      "description": "Actuator endpoints exposed by the local application configuration.",
      "item": [
        {
          "name": "Actuator discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator",
            "description": "Links to the Actuator endpoints exposed by the application."
          },
          "response": []
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "Overall application health."
          },
          "response": []
        },
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health/liveness",
            "description": "Kubernetes-style liveness probe."
          },
          "response": []
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health/readiness",
            "description": "Kubernetes-style readiness probe."
          },
          "response": []
        },
        {
          "name": "Application info",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/info",
            "description": "Application metadata configured under the info namespace."
          },
          "response": []
        },
        {
          "name": "Metrics index",
          "request": {
            "method": "GET",
            "header": [],
