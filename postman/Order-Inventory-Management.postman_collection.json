        {
          "name": "Prometheus scrape",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/prometheus",
            "description": "Prometheus text exposition endpoint."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Prepare repeatable test data",
      "description": "Creates a fresh Product A/B/C set with assessment quantities 10/5/20 and a separate Product D for restock, payment-failure, and cancellation tests. Running this folder makes the remaining collection repeatable without depending on the persisted seed state.",
      "item": [
        {
          "name": "Create fresh Product A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Creates Product A with 10 available units and stores its productId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productASku}}\",\n  \"name\": \"Postman Product A\",\n  \"unitPrice\": 19.99,\n  \"initialQuantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Create fresh Product B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Creates Product B with 5 available units and stores its productId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productBSku}}\",\n  \"name\": \"Postman Product B\",\n  \"unitPrice\": 29.99,\n  \"initialQuantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Create fresh Product C",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Creates Product C with 20 available units and stores its productId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productCSku}}\",\n  \"name\": \"Postman Product C\",\n  \"unitPrice\": 9.99,\n  \"initialQuantity\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Create Product D for restock tests",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Creates a zero-stock product that the restock endpoint will raise to 25 units.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productDSku}}\",\n  \"name\": \"Postman Product D\",\n  \"unitPrice\": 14.5,\n  \"initialQuantity\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Product APIs",
      "item": [
        {
          "name": "List products and inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Lists catalog entries ordered by SKU."
          },
          "response": []
        },
        {
          "name": "Get Product A",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/{{productAId}}",
            "description": "Reads one product and its current available/reserved quantities."
          },
          "response": []
        },
        {
          "name": "Restock Product D",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products/{{productDId}}/restocks",
            "description": "Adds 25 units to Product D using the atomic restock endpoint.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get restocked Product D",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/{{productDId}}",
            "description": "Verifies the persisted restock result."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Successful order and payment",
      "description": "Runs the exact A x 2, B x 1, C x 5 assessment basket and confirms it.",
      "item": [
        {
          "name": "Create assessment order and reserve inventory",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-assessment-success",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "Creates the exact assessment basket and reserves every item atomically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"postman-success-{{$timestamp}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productAId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{productBId}}\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"{{productCId}}\",\n      \"quantity\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get reserved assessment order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orders/{{successfulOrderId}}",
            "description": "Reads the order before payment."
          },
          "response": []
        },
        {
          "name": "Simulate successful payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{successPaymentKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{successfulOrderId}}/payments",
            "description": "Commits reserved inventory and confirms the order.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Retry successful payment with same key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{successPaymentKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{successfulOrderId}}/payments",
            "description": "Demonstrates idempotency: the same key and payload return the confirmed order without another charge.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get confirmed order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orders/{{successfulOrderId}}",
            "description": "Reads the final successful state."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Payment failure and compensation",
      "item": [
        {
          "name": "Create order that will fail payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "Reserves three Product D units for the failure path.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"postman-payment-failure-{{$timestamp}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productDId}}\",\n      \"quantity\": 3\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Simulate failed payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{failurePaymentKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{failedOrderId}}/payments",
            "description": "Releases the three reserved units and moves the order to PAYMENT_FAILED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"FAILURE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get payment-failed order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orders/{{failedOrderId}}",
            "description": "Reads the terminal failed state."
          },
          "response": []
        },
        {
          "name": "Verify failure released Product D inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/{{productDId}}",
            "description": "Product D returns to 25 available and zero reserved units after compensation."
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Cancellation and release",
      "item": [
        {
          "name": "Create order that will be cancelled",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "Reserves four Product D units for the cancellation path.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"postman-cancellation-{{$timestamp}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productDId}}\",\n      \"quantity\": 4\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Cancel order",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orders/{{cancelledOrderId}}/cancellations",
            "description": "Cancels the order and releases its four reserved units."
          },
          "response": []
        },
        {
          "name": "Retry cancellation",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orders/{{cancelledOrderId}}/cancellations",
            "description": "Demonstrates idempotent cancellation for an already cancelled order."
          },
          "response": []
        },
        {
          "name": "Verify cancellation released Product D inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/{{productDId}}",
            "description": "Product D returns to 25 available and zero reserved units after cancellation."
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Expected error examples",
      "description": "Optional negative tests. Each request passes when the documented problem response is returned.",
      "item": [
        {
          "name": "Insufficient inventory",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "Requests the maximum valid line quantity from a product with only 25 units.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"postman-insufficient-inventory\",\n  \"items\": [\n    {\n      \"productId\": \"{{productDId}}\",\n      \"quantity\": 1000000\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Unknown product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/00000000-0000-0000-0000-000000000000",
            "description": "Demonstrates the standard 404 ProblemDetail response."
          },
          "response": []
        },
        {
          "name": "Missing payment idempotency key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{successfulOrderId}}/payments",
            "description": "Omits the mandatory Idempotency-Key header.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Duplicate SKU",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Attempts to create another product with Product A's normalized SKU.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productASku}}\",\n  \"name\": \"Duplicate Product A\",\n  \"unitPrice\": 19.99,\n  \"initialQuantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    }
  ]
}
