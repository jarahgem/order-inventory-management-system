    {
      "name": "01 - Prepare repeatable test data",
      "description": "Creates a fresh Product A/B/C set with assessment quantities 10/5/20 and a separate Product D for restock, payment-failure, and cancellation tests. Running this folder makes the remaining collection repeatable without depending on the persisted seed state.",
      "item": [
        {
          "name": "Create fresh Product A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/products",
            "description": "Creates Product A with 10 available units and stores its productId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productASku}}\",\n  \"name\": \"Postman Product A\",\n  \"unitPrice\": 19.99,\n  \"initialQuantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const randomPart = Math.floor(Math.random() * 1000000).toString().padStart(6, '0');",
                  "pm.collectionVariables.set('productASku', 'POSTMAN-A-' + Date.now() + '-' + randomPart);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Location header is present', function () { pm.expect(pm.response.headers.has('Location')).to.be.true; });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('productAId', body.productId);",
                  "pm.test('Initial quantity is 10', function () { pm.expect(body.availableQuantity).to.eql(10); });",
                  "pm.test('Nothing is reserved', function () { pm.expect(body.reservedQuantity).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create fresh Product B",
