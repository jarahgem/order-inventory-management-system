    {
      "name": "03 - Successful order and payment",
      "description": "Runs the exact A x 2, B x 1, C x 5 assessment basket and confirms it.",
      "item": [
        {
          "name": "Create assessment order and reserve inventory",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-assessment-success",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "Creates the exact assessment basket and reserves every item atomically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"postman-success-{{$timestamp}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productAId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{productBId}}\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"{{productCId}}\",\n      \"quantity\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('successfulOrderId', body.orderId);",
                  "pm.collectionVariables.set('successPaymentKey', 'payment-success-' + Date.now() + '-' + Math.floor(Math.random() * 1000000));",
                  "pm.test('Inventory is reserved', function () { pm.expect(body.status).to.eql('INVENTORY_RESERVED'); });",
                  "pm.test('Three order items are returned', function () { pm.expect(body.items).to.have.length(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get reserved assessment order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orders/{{successfulOrderId}}",
            "description": "Reads the order before payment."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order remains reserved', function () { pm.expect(pm.response.json().status).to.eql('INVENTORY_RESERVED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulate successful payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{successPaymentKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{successfulOrderId}}/payments",
            "description": "Commits reserved inventory and confirms the order.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order is confirmed', function () { pm.expect(pm.response.json().status).to.eql('CONFIRMED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry successful payment with same key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{successPaymentKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{successfulOrderId}}/payments",
            "description": "Demonstrates idempotency: the same key and payload return the confirmed order without another charge.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"SUCCESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order is still confirmed', function () { pm.expect(pm.response.json().status).to.eql('CONFIRMED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get confirmed order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orders/{{successfulOrderId}}",
            "description": "Reads the final successful state."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order is confirmed', function () { pm.expect(pm.response.json().status).to.eql('CONFIRMED'); });"
                ]
              }
            }
          ]
        }
      ]
    },
