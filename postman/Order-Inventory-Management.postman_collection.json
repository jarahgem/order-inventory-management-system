{
  "info": {
    "_postman_id": "552b33e7-5cb1-47e4-83d9-b39ec12c72de",
    "name": "Order & Inventory Management System",
    "description": "Complete local test collection for every business API and the configured Actuator health/observability routes. Run folders in numeric order. The setup folder creates fresh products, captures IDs, and makes success, payment-failure, cancellation, idempotency, and error flows repeatable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
