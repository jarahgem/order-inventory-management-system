      "_id": "req_orders_cancel",
      "_type": "request",
      "parentId": "fld_orders",
      "name": "Cancel order (client)",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/orders/{{ _.orderId }}/cancellations",
      "body": {},
      "headers": [],
      "authentication": {
        "type": "basic",
        "useISO88591": false,
        "username": "{{ _.clientUser }}",
        "password": "{{ _.clientPass }}"
      },
      "metaSortKey": 305
    }
